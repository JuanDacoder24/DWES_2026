{
  "name": "biblioteca-api",
  "version": "1.0.0",
  "description": "API REST para gestionar una biblioteca con TypeScript y Node.js",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "keywords": ["typescript", "nodejs", "express", "mysql", "crud"],
  "author": "Tu Nombre",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
